# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.swp

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# pytest cache
.pytest_cache/

# Local configuration (if needed)
.env.local
.env.*.local

