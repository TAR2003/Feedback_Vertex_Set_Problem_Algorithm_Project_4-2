# ============================================================================
# Data Files (Generated/Downloaded at Runtime)
# ============================================================================
# These should NOT be committed to Git; they are reproducibly generated
# or downloaded automatically by the project. Users run "python main.py" to regenerate.

# Synthetic graphs (generated via data/generator.py)
/data/synthetic/
/data/synthetic/*
!data/synthetic/.gitkeep

# Real-world graphs (downloaded via data/downloader.py)
/data/real_world/
/data/real_world/*
!data/real_world/.gitkeep

# ============================================================================
# Experiment Results & Outputs (Auto-Generated)
# ============================================================================

# Experiment results, logs, and intermediate data
/results/
/results/*
!results/.gitkeep

# Generated figures (from plot.py)
# /figures/
# /figures/*
# #!figures/.gitkeep

